---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection('posts');
const post = posts.find((p) => p.id === slug);

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const { Content, headings } = await render(post);
const { title, date, type, tags, summary } = post.data;
const tocItems = headings.filter((h) => h.depth <= 3);
const readMin = Math.max(1, Math.ceil(post.body.replace(/[#*`>\-\[\]\(\)!|~_]/g, '').replace(/\s+/g, '').length / 400));
---

<Base title={title} description={summary}>
  <div class="article-layout">
    {tocItems.length > 0 && (
      <aside class="toc">
        <nav>
          <p class="toc-title">目录</p>
          <ul>
            {tocItems.map((h) => (
              <li class={`toc-item toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
    <article class="article">
      <p class="kind"><T k={type === 'article' ? 'kind.article' : 'kind.essay'} /></p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{date.toLocaleDateString('zh-CN')}</time>
        <span> · {readMin} min read</span>
        {tags.length > 0 && <span> · {tags.join(' / ')}</span>}
      </p>
      <Content />
    </article>
  </div>
</Base>

<style>
  .article-layout {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  /* 左侧目录 */
  .toc {
    position: sticky;
    top: 5rem;
    width: 200px;
    flex-shrink: 0;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }
  .toc-title {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0 0 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--color-border);
  }
  .toc-item {
    padding-left: 1rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    transition: border-color 0.15s;
  }
  .toc-item a {
    display: block;
    padding: 0.3rem 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
    line-height: 1.4;
  }
  .toc-item a:hover {
    color: var(--color-accent);
  }
  .toc-depth-3 {
    padding-left: 1.8rem;
  }
  .toc-depth-3 a {
    font-size: 0.78rem;
  }

  /* 文章正文 */
  .article {
    max-width: 720px;
    flex: 1;
    min-width: 0;
  }
  .kind {
    color: var(--color-accent);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }
  .article :global(p) {
    line-height: 1.75;
    margin: 1.1rem 0;
  }
  .article :global(h2) {
    font-family: Georgia, "PingFang SC", serif;
    margin: 2.2rem 0 1rem;
  }
  .article :global(h3) {
    margin: 1.8rem 0 0.8rem;
  }
  .article :global(pre) {
    background: var(--color-surface);
    padding: 1rem 1.2rem;
    border-radius: 8px;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
  .article :global(code) {
    font-family: "JetBrains Mono", Consolas, monospace;
  }
  .article :global(:not(pre) > code) {
    background: var(--color-surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .article :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    margin: 1.5rem 0;
    padding: 0.2rem 0 0.2rem 1rem;
    color: var(--color-text-muted);
  }
  .article :global(a) {
    color: var(--color-accent);
  }
  .article :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .article :global(th),
  .article :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }
  .article :global(th) {
    background: var(--color-surface);
  }
  .article :global(ul),
  .article :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
    line-height: 1.75;
  }
  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 2.5rem;
  }

  /* 移动端：隐藏目录 */
  @media (max-width: 900px) {
    .toc {
      display: none;
    }
    .article-layout {
      padding: 2rem 1.5rem 4rem;
    }
  }
</style>

<script>
  // 滚动时高亮当前章节
  const tocLinks = document.querySelectorAll('.toc-item a');
  const headings = Array.from(document.querySelectorAll('.article h2, .article h3'));
  if (tocLinks.length && headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              const isActive = link.getAttribute('href') === `#${id}`;
              link.style.color = isActive ? 'var(--color-accent)' : '';
              link.style.fontWeight = isActive ? '600' : '';
            });
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
