---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const readingTime = (body: string) => {
  const text = body.replace(/[#*`>\-\[\]\(\)!|~_]/g, '').replace(/\s+/g, '');
  return Math.max(1, Math.ceil(text.length / 400));
};
---

<Base title="博客">
  <section class="container">
    <h1><T k="section.blog" /></h1>
    <div class="tabs">
      <button class="tab active" data-filter="all"><T k="filter.all" /></button>
      <button class="tab" data-filter="article"><T k="filter.article" /></button>
      <button class="tab" data-filter="essay"><T k="filter.essay" /></button>
    </div>
    {
      posts.length === 0 ? (
        <p class="empty"><T k="empty.noContent" /></p>
      ) : (
        <ul class="post-list">
          {posts.map((p) => (
            <li data-type={p.data.type}>
              <a href={`${import.meta.env.BASE_URL}/blog/${p.id}/`} class="post-item">
                <div class="post-left">
                  <span class="post-date">{p.data.date.toLocaleDateString('zh-CN')}</span>
                  <span class="post-kind">
                    <T k={p.data.type === 'article' ? 'kind.article' : 'kind.essay'} />
                  </span>
                </div>
                <div class="post-body">
                  <h2 class="post-title">{p.data.title}</h2>
                  {p.data.summary && <p class="post-summary">{p.data.summary}</p>}
                  <div class="post-meta">
                    {p.data.tags.length > 0 && (
                      <span class="post-tags">
                        {p.data.tags.map((t) => (
                          <span class="post-tag">{t}</span>
                        ))}
                      </span>
                    )}
                    <span class="post-read">{readingTime(p.body)} min read</span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<script>
  const tabs = document.querySelectorAll('.tab');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const filter = tab.getAttribute('data-filter');
      document.querySelectorAll('.post-list li').forEach((li) => {
        const type = li.getAttribute('data-type');
        li.style.display = filter === 'all' || type === filter ? '' : 'none';
      });
    });
  });
</script>

<style>
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .tab {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    padding: 0.4rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.9rem;
    font-family: inherit;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab:hover {
    color: var(--color-text);
  }
  .tab.active {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    border-bottom: 1px solid var(--color-border);
  }
  .post-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0;
    color: var(--color-text);
    text-decoration: none;
  }
  .post-item:hover {
    text-decoration: none;
  }
  .post-item:hover .post-title {
    color: var(--color-accent);
  }
  .post-left {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex-shrink: 0;
    width: 6rem;
  }
  .post-date {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .post-kind {
    color: var(--color-accent);
    font-size: 0.78rem;
  }
  .post-body {
    flex: 1;
    min-width: 0;
  }
  .post-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
    line-height: 1.4;
    transition: color 0.15s;
  }
  .post-summary {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0 0 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .post-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .post-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }
  .post-read {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .empty {
    color: var(--color-text-muted);
  }
  @media (max-width: 600px) {
    .post-left {
      flex-direction: row;
      width: auto;
      gap: 0.8rem;
    }
  }
</style>
