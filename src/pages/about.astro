---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---

<Base title="关于" description="About learnerCodeZ">
  <section class="container">
    <h1><T k="nav.about" /></h1>
    <p class="empty"><T k="empty.comingSoon" /></p>

    <!-- 联系方式 -->
    <div class="contact">
      <h2 class="contact-title"><T k="contact.title" /></h2>
      <a class="contact-email" href="mailto:2937884271@qq.com">
        <svg class="contact-icon" width="22" height="16" viewBox="0 0 14 10" shape-rendering="crispEdges" aria-hidden="true">
          <!-- 信封边框 -->
          <rect x="0" y="0" width="14" height="1" fill="currentColor" />
          <rect x="0" y="9" width="14" height="1" fill="currentColor" />
          <rect x="0" y="0" width="1" height="10" fill="currentColor" />
          <rect x="13" y="0" width="1" height="10" fill="currentColor" />
          <!-- 翻盖 V -->
          <rect x="0" y="1" width="2" height="1" fill="currentColor" />
          <rect x="12" y="1" width="2" height="1" fill="currentColor" />
          <rect x="2" y="2" width="2" height="1" fill="currentColor" />
          <rect x="10" y="2" width="2" height="1" fill="currentColor" />
          <rect x="4" y="3" width="2" height="1" fill="currentColor" />
          <rect x="8" y="3" width="2" height="1" fill="currentColor" />
          <rect x="6" y="4" width="2" height="1" fill="currentColor" />
        </svg>
        <span class="contact-text">
          <span class="contact-label"><T k="contact.email" /></span>
          <span class="contact-value">2937884271@qq.com</span>
        </span>
      </a>
    </div>
  </section>
</Base>

<style>
  .contact {
    margin-top: 4rem;
  }
  .contact-title {
    font-family: Georgia, "PingFang SC", serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
    position: relative;
    padding-left: 0.8rem;
  }
  .contact-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    bottom: 0.15em;
    width: 5px;
    background: var(--color-accent);
  }
  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.6rem;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .contact-email:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 24px -8px var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .contact-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .contact-label {
    color: var(--color-accent);
    font-size: 0.75rem;
  }
  .contact-value {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
</style>
