---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { PROJECTS } from '../data/projects';

const projects = [...PROJECTS].sort((a, b) => b.published.localeCompare(a.published));
const statusText = (s: string) =>
  s === 'active' ? '● ACTIVE' : s === 'maintained' ? '◆ MAINTAINED' : '○ ARCHIVED';
---

<Base title="项目">
  <section class="container">
    <h1><T k="section.projects" /></h1>
    <ul class="project-list">
      {
        projects.map((p) => (
          <li id={p.slug}>
            <div class="pl-left">
              <div class="pl-title-row">
                <span class="pl-name">{p.name}</span>
                <span class={`pl-status status-${p.status}`}>{statusText(p.status)}</span>
              </div>
              <span class="pl-desc">{p.description}</span>
              <span class="pl-tags">{p.tags.join(' · ')}</span>
              <span class="pl-date">{p.date}</span>
            </div>
            <a class="pl-source" href={p.link} target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.37.5 0 5.78 0 12.292c0 5.211 3.438 9.63 8.205 11.188.6.111.82-.254.82-.567 0-.28-.01-1.022-.015-2.005-3.338.711-4.042-1.582-4.042-1.582-.546-1.361-1.335-1.725-1.335-1.725-1.087-.731.084-.716.084-.716 1.205.082 1.838 1.215 1.838 1.215 1.07 1.805 2.809 1.284 3.495.981.108-.763.417-1.284.76-1.579-2.665-.295-5.466-1.309-5.466-5.827 0-1.287.465-2.339 1.235-3.164-.135-.298-.54-1.497.105-3.121 0 0 1.005-.316 3.3 1.209.96-.262 1.98-.392 3-.398 1.02.006 2.04.136 3 .398 2.28-1.525 3.285-1.209 3.285-1.209.645 1.624.24 2.823.12 3.121.765.825 1.23 1.877 1.23 3.164 0 4.53-2.805 5.527-5.475 5.817.42.354.81 1.077.81 2.182 0 1.578-.015 2.846-.015 3.229 0 .309.21.678.825.563C20.565 21.917 24 17.495 24 12.292 24 5.78 18.627.5 12 .5z"/>
              </svg>
              source code →
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .project-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px dashed var(--color-border);
    padding: 1.5rem 0;
    scroll-margin-top: 6rem;
  }
  .pl-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .pl-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }
  .pl-name {
    font-family: Georgia, 'PingFang SC', serif;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .pl-status {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
  }
  .status-active {
    color: var(--color-accent);
  }
  .status-maintained {
    color: #7dd3c0;
  }
  .status-archived {
    color: var(--color-text-muted);
    opacity: 0.6;
  }
  .pl-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .pl-tags {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .pl-date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
  .pl-source {
    flex-shrink: 0;
    color: var(--color-accent);
    font-size: 0.9rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .pl-source:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .project-list li {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
