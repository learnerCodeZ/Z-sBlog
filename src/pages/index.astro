---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { getCollection } from 'astro:content';
import { PROJECTS } from '../data/projects';
import { getI18N } from '../data/i18n';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recent = [
  ...allPosts.map((p) => ({
    kindZh: getI18N(p.data.type === 'article' ? 'kind.article' : 'kind.essay').zh,
    kindEn: getI18N(p.data.type === 'article' ? 'kind.article' : 'kind.essay').en,
    title: p.data.title,
    date: p.data.date,
    link: `${import.meta.env.BASE_URL}/blog/${p.id}/`,
  })),
  ...PROJECTS.map((p) => ({
    kindZh: getI18N('kind.project').zh,
    kindEn: getI18N('kind.project').en,
    title: p.name,
    date: new Date(p.published),
    link: import.meta.env.BASE_URL + '/projects#' + p.slug,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const blogItems = allPosts.slice(0, 3);
const RECENT_SLOTS = 5;
const BLOG_SLOTS = 3;
const range = (n: number) => Array.from({ length: Math.max(0, n) }, (_, i) => i);
---

<Base>
  <!-- hero -->
  <section class="wrap hero">
    <p class="meta"><T k="hero.tagline" /></p>
    <h1 class="display">learnerCodeZ</h1>
    <p class="intro"><T k="hero.intro" /></p>
  </section>

  <!-- 最近 -->
  <section class="wrap">
    <h2 class="section-title"><a href={`${import.meta.env.BASE_URL}/blog`}><T k="section.recent" /></a></h2>
    <div class="recent" id="recent">
      <div class="track">
        {
          recent.map((item) => (
            <a class="card" href={item.link}>
              <span class="kind">
                <span data-zh>{item.kindZh}</span><span data-en>{item.kindEn}</span>
              </span>
              <span class="card-title">{item.title}</span>
              <span class="date">{item.date.toLocaleDateString('zh-CN')}</span>
            </a>
          ))
        }
        {
          range(RECENT_SLOTS - recent.length).map(() => (
            <div class="card placeholder">
              <span class="kind">—</span>
              <span class="card-title"><T k="empty.toAdd" /></span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 博客 -->
  <section class="wrap">
    <div class="section-head">
      <h2 class="section-title"><a href={`${import.meta.env.BASE_URL}/blog`}><T k="section.blog" /></a></h2>
      <div class="carousel-controls">
        <button class="carousel-btn" data-prev aria-label="Previous">←</button>
        <button class="carousel-btn" data-next aria-label="Next">→</button>
      </div>
    </div>
    <div class="carousel-viewport" data-carousel>
      <div class="carousel-track">
        {
          blogItems.map((p) => (
            <a class="card" href={`${import.meta.env.BASE_URL}/blog/${p.id}/`}>
              <span class="kind">
                <T k={p.data.type === 'article' ? 'kind.article' : 'kind.essay'} />
              </span>
              <span class="card-title">{p.data.title}</span>
              {p.data.summary && <span class="pc-desc">{p.data.summary}</span>}
              <span class="date">{p.data.date.toLocaleDateString('zh-CN')}</span>
            </a>
          ))
        }
        {
          range(BLOG_SLOTS - blogItems.length).map(() => (
            <div class="card placeholder">
              <span class="kind">—</span>
              <span class="card-title"><T k="empty.toAdd" /></span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 项目 -->
  <section class="wrap">
    <div class="section-head">
      <h2 class="section-title"><a href={`${import.meta.env.BASE_URL}/projects`}><T k="section.projects" /></a></h2>
      <div class="carousel-controls">
        <button class="carousel-btn" data-prev aria-label="Previous">←</button>
        <button class="carousel-btn" data-next aria-label="Next">→</button>
      </div>
    </div>
    <div class="carousel-viewport" data-carousel>
      <div class="carousel-track">
        {
          PROJECTS.map((p) => (
            <a class="card project-card" href={import.meta.env.BASE_URL + '/projects#' + p.slug}>
              <span class={`kind status-${p.status}`}>
                {p.status === 'active'
                  ? '● ACTIVE'
                  : p.status === 'maintained'
                    ? '◆ MAINTAINED'
                    : '○ ARCHIVED'}
              </span>
              <span class="card-title">{p.name}</span>
              <span class="pc-desc">{p.description}</span>
              <div class="pc-tags">
                {p.tags.map((t) => (
                  <span class="pc-tag">{t}</span>
                ))}
              </div>
              <span class="date">{p.date}</span>
            </a>
          ))
        }
        {
          range(Math.max(0, 3 - PROJECTS.length)).map(() => (
            <div class="card placeholder">
              <span class="kind">—</span>
              <span class="card-title"><T k="empty.toAdd" /></span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

</Base>

<script>
  const recent = document.getElementById('recent');
  if (recent) {
    recent.addEventListener(
      'wheel',
      (e) => {
        const vertical = Math.abs(e.deltaY) > Math.abs(e.deltaX);
        if (!vertical) return;
        const max = recent.scrollWidth - recent.clientWidth;
        const canRoll = e.deltaY > 0 ? recent.scrollLeft < max - 1 : recent.scrollLeft > 1;
        if (canRoll) {
          e.preventDefault();
          recent.scrollLeft += e.deltaY;
        }
      },
      { passive: false }
    );
  }

  document.querySelectorAll('[data-carousel]').forEach((vp) => {
    const root = vp.closest('.wrap');
    const track = vp.querySelector('.carousel-track');
    const prev = root?.querySelector('[data-prev]') as HTMLButtonElement | null;
    const next = root?.querySelector('[data-next]') as HTMLButtonElement | null;
    if (!track || !prev || !next) return;
    const cards = Array.from(track.querySelectorAll('.card'));
    if (!cards.length) return;
    let active = 0;

    const layout = () => {
      const cardW = cards[0].getBoundingClientRect().width;
      const gap = 16;
      const offset = (vp.clientWidth - cardW) / 2;
      track.style.transform = `translateX(${offset - active * (cardW + gap)}px)`;
    };
    const render = () => {
      cards.forEach((c, i) => c.classList.toggle('active', i === active));
      prev.disabled = active <= 0;
      next.disabled = active >= cards.length - 1;
    };
    prev.addEventListener('click', () => {
      if (active > 0) {
        active--;
        layout();
        render();
      }
    });
    next.addEventListener('click', () => {
      if (active < cards.length - 1) {
        active++;
        layout();
        render();
      }
    });
    window.addEventListener('resize', layout);
    layout();
    render();
  });
</script>

<style>
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .hero {
    padding-top: 5rem;
  }
  .meta {
    color: var(--color-accent);
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    margin: 0 0 1.2rem;
  }
  .display {
    font-family: Georgia, "PingFang SC", "Songti SC", serif;
    font-size: 2.8rem;
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }
  .intro {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 38ch;
    line-height: 1.7;
  }

  .section-title {
    font-family: Georgia, "PingFang SC", serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 2.2rem 1.7rem;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    color: var(--color-text);
    transition: border-color 0.15s, transform 0.15s;
  }
  a.card:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .card.placeholder {
    border-style: dashed;
    opacity: 0.4;
    pointer-events: none;
  }
  .card .kind {
    color: var(--color-accent);
    font-size: 0.8rem;
  }
  .card-title {
    font-size: 1rem;
    line-height: 1.4;
  }
  .card .date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .recent {
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    margin-bottom: 1.5rem;
  }
  .recent::-webkit-scrollbar {
    display: none;
  }
  .recent .track {
    display: flex;
    gap: 1rem;
    padding-bottom: 0.5rem;
  }
  .recent .track .card {
    flex: 0 0 320px;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .section-head .section-title {
    margin: 0;
  }
  .carousel-controls {
    display: flex;
    gap: 0.5rem;
  }
  .carousel-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s, border-color 0.15s, color 0.15s;
  }
  .carousel-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .carousel-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  .carousel-viewport {
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .carousel-track {
    display: flex;
    gap: 1rem;
    transition: transform 0.4s ease;
    will-change: transform;
  }
  .carousel-track .card {
    flex: 0 0 340px;
    opacity: 0.35;
    transform: scale(0.9);
    transition: opacity 0.3s, transform 0.3s, border-color 0.3s;
  }
  .carousel-track .card.active {
    opacity: 1;
    transform: scale(1);
    border-color: var(--color-accent);
  }

  .pc-desc {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.4;
    margin-top: 0.3rem;
  }
  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }
  .pc-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }
  .project-card .kind.status-active {
    color: var(--color-accent) !important;
  }
  .project-card .kind.status-maintained {
    color: #7dd3c0 !important;
  }
  .project-card .kind.status-archived {
    color: var(--color-text-muted) !important;
    opacity: 0.6;
  }

  @media (max-width: 700px) {
    .display {
      font-size: 2.2rem;
    }
    .hero {
      padding-top: 3.5rem;
    }
    .recent .track .card {
      flex: 0 0 220px;
    }
    .carousel-track .card {
      flex: 0 0 calc((100% - 1rem) / 2);
    }
  }
  @media (max-width: 480px) {
    .carousel-track .card {
      flex: 0 0 100%;
    }
  }
</style>
