---
import Base from '../layouts/Base.astro';
---

<Base title="留言">
  <section class="container">
    <h1>留言</h1>
    <p class="gb-intro">匿名留言，留下你想说的话。</p>
    <div id="waline"></div>
  </section>
</Base>

<script>
  import { init } from '@waline/client';
  import '@waline/client/waline.css';
  const serverURL = 'https://your-waline.vercel.app'; // TODO: 换成你部署的 Waline 地址
  const el = document.getElementById('waline');
  if (serverURL.includes('your-waline')) {
    el.innerHTML =
      '<p style="color:var(--color-text-muted)">留言功能即将上线（Waline 后端部署中）。</p>';
  } else {
    init({ el: '#waline', serverURL });
  }
</script>

<style>
  .gb-intro {
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }
</style>
