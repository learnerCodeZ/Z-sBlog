---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---

<Base title="留言">
  <section class="container">
    <h1><T k="guestbook.title" /></h1>
    <p class="gb-intro"><T k="guestbook.intro" /></p>
    <div id="waline"></div>
  </section>
</Base>

<script>
  import { init } from '@waline/client';
  import '@waline/client/waline.css';
  const serverURL = 'https://your-waline.vercel.app';
  const el = document.getElementById('waline');
  if (serverURL.includes('your-waline')) {
    const isEn = document.documentElement.lang === 'en';
    el.innerHTML = isEn
      ? '<p style="color:var(--color-text-muted)">Comments coming soon (Waline backend deploying).</p>'
      : '<p style="color:var(--color-text-muted)">留言功能即将上线（Waline 后端部署中）。</p>';
  } else {
    init({ el: '#waline', serverURL });
  }
</script>

<style>
  .gb-intro {
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }
</style>
