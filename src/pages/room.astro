---
import Base from '../layouts/Base.astro';
---

<Base title="房间">
  <div class="room-wrap" id="room"></div>

  <!-- hover 提示 -->
  <div class="room-tip" id="roomTip"><span data-zh>留言板</span><span data-en>Message Board</span></div>
</Base>

<script>
  import { initRoomPixel } from '../scripts/room-pixel';
  const el = document.getElementById('room');
  if (el) initRoomPixel(el as HTMLElement);
</script>

<style>
  .room-wrap {
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }
  /* 像素画：保持 480:300 比例、放大时硬边像素 */
  :global(.room-wrap canvas.room-pixel-canvas) {
    image-rendering: pixelated;
    width: min(96vw, calc(88vh * (480 / 300)));
    height: auto;
    aspect-ratio: 480 / 300;
    border-radius: 4px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35);
  }

  /* 平移舞台 + 左右按钮 */
  :global(.room-stage) {
    position: relative;
    display: inline-block;
    line-height: 0;
  }
  :global(.room-pan) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 52px;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    opacity: 0.65;
    transition: opacity 0.15s, border-color 0.15s, color 0.15s;
  }
  :global(.room-pan:hover:not(:disabled)) {
    opacity: 1;
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  :global(.room-pan:disabled) {
    opacity: 0.2;
    cursor: default;
  }
  :global(.room-pan-left) { left: 8px; }
  :global(.room-pan-right) { right: 8px; }

  .room-tip {
    display: none;
    position: fixed;
    pointer-events: none;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.8rem;
    padding: 0.25rem 0.55rem;
    border-radius: 5px;
    z-index: 50;
    white-space: nowrap;
  }
</style>
