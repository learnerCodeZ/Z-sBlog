---
import Base from '../layouts/Base.astro';
---

<Base title="房间">
  <div class="room-wrap" id="room"></div>
</Base>

<script>
  import { initRoom } from '../scripts/room-scene';
  const el = document.getElementById('room');
  let cleanup: (() => void) | undefined;
  if (el) cleanup = initRoom(el as HTMLElement);
</script>

<style>
  .room-wrap {
    width: 100%;
    height: 100vh;
  }
  :global(.room-wrap canvas) {
    display: block;
  }
</style>
