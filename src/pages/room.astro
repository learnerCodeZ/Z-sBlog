---
import Base from '../layouts/Base.astro';
---

<Base title="房间">
  <div class="room-wrap" id="room"></div>

  <!-- hover 提示 -->
  <div class="room-tip" id="roomTip"><span data-zh>留言板</span><span data-en>Message Board</span></div>
</Base>

<script>
  import { initRoom2D } from '../scripts/room-2d-3d';
  const el = document.getElementById('room');
  if (el) initRoom2D(el as HTMLElement);
</script>

<style>
  .room-wrap {
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }
  :global(.room-wrap canvas) {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 8px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
  }

  .room-tip {
    display: none;
    position: fixed;
    pointer-events: none;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.8rem;
    padding: 0.25rem 0.55rem;
    border-radius: 5px;
    z-index: 50;
    white-space: nowrap;
  }
</style>
