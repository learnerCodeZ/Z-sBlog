---
import Base from '../layouts/Base.astro';
---

<Base title="房间">
  <div class="room-wrap" id="room"></div>

  <!-- hover 提示 -->
  <div class="room-tip" id="roomTip"><span data-zh>留言板</span><span data-en>Message Board</span></div>
</Base>

<script>
  import { initRoom } from '../scripts/room-scene';
  const el = document.getElementById('room');
  let cleanup: (() => void) | undefined;
  if (el) cleanup = initRoom(el as HTMLElement);
</script>

<style>
  .room-wrap {
    width: 100%;
    height: 100vh;
  }
  :global(.room-wrap canvas) {
    display: block;
  }

  .room-tip {
    display: none;
    position: fixed;
    pointer-events: none;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.8rem;
    padding: 0.25rem 0.55rem;
    border-radius: 5px;
    z-index: 50;
    white-space: nowrap;
  }
</style>
