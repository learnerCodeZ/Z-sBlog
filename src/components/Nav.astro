---
import { SITE, NAV_LINKS } from '../data/site';
import T from './T.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import GitHubIcon from './icons/GitHub.astro';
import BilibiliIcon from './icons/Bilibili.astro';

const path = Astro.url.pathname;
const _base = import.meta.env.BASE_URL.replace(/\/$/, ''); // dev: '' prod: '/Z-sBlog'
---

<header>
  <nav>
    <a href={`${_base}/`} class="logo" id="siteLogo">{SITE.name}</a>
    <div class="links">
      {
        NAV_LINKS.map((l) => (
          <a
            href={`${_base}${l.href}`}
            class:list={['nav-link', { active: path.startsWith(`${_base}${l.href}`) }]}
          >
            <T k={`nav.${l.href.slice(1)}`} />
          </a>
        ))
      }
    </div>
    <div class="social">
      <a href={SITE.social.github} target="_blank" rel="noopener" aria-label="GitHub">
        <GitHubIcon />
      </a>
      <a href={SITE.social.bilibili} target="_blank" rel="noopener" aria-label="Bilibili">
        <BilibiliIcon />
      </a>
      <LangToggle />
      <ThemeToggle />
    </div>
    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-label="菜单"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg width="18" height="14" viewBox="0 0 9 7" shape-rendering="crispEdges" aria-hidden="true">
        <rect x="0" y="0" width="9" height="1" fill="currentColor" />
        <rect x="0" y="3" width="9" height="1" fill="currentColor" />
        <rect x="0" y="6" width="9" height="1" fill="currentColor" />
      </svg>
    </button>
  </nav>
  <div class="mobile-menu" id="mobileMenu" hidden>
    {
      NAV_LINKS.map((l) => (
        <a
          href={`${_base}${l.href}`}
          class:list={['mobile-link', { active: path.startsWith(`${_base}${l.href}`) }]}
        >
          <T k={`nav.${l.href.slice(1)}`} />
        </a>
      ))
    }
  </div>
</header>

<style>
  header {
    border-bottom: 2px solid var(--color-border);
    position: sticky;
    top: 0;
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  nav {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .logo {
    font-family: var(--font-pixel);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }
  .logo:hover {
    text-decoration: none;
    color: var(--color-accent);
  }
  .links {
    display: flex;
    gap: 1.25rem;
    flex: 1;
  }
  .nav-link {
    position: relative;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    padding-bottom: 2px;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
    text-decoration: none;
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 3px;
    background: repeating-linear-gradient(90deg, var(--color-accent) 0 3px, transparent 3px 6px);
  }
  /* 英文模式：导航链接用像素字体（与 logo 一致；中文保持可读）*/
  :global(html[lang='en']) .nav-link {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
  }
  .social {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .social a {
    color: var(--color-text-muted);
    display: flex;
  }
  .social a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* 汉堡：默认隐藏，窄屏显示 */
  .menu-toggle {
    display: none;
    width: 36px;
    height: 36px;
    border: 2px solid var(--color-border);
    border-radius: 0;
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    padding: 0;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s;
  }
  .menu-toggle:hover,
  .menu-toggle[aria-expanded='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* 窄屏：横向链接收起，汉堡出现；宽屏强制藏下拉（防从窄屏拖宽后残留） */
  @media (max-width: 600px) {
    .links {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }
  @media (min-width: 601px) {
    .mobile-menu:not([hidden]) {
      display: none;
    }
  }

  /* 移动端下拉：像素直角面板 */
  .mobile-menu {
    display: none;
    border-top: 2px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.4rem 1.5rem 0.8rem;
  }
  .mobile-menu:not([hidden]) {
    display: block;
  }
  .mobile-link {
    display: block;
    padding: 0.85rem 0.25rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    border-bottom: 1px dashed var(--color-border);
    position: relative;
  }
  .mobile-link:last-child {
    border-bottom: none;
  }
  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-text);
    text-decoration: none;
  }
  .mobile-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85rem;
    bottom: 0.85rem;
    width: 3px;
    background: repeating-linear-gradient(
      180deg,
      var(--color-accent) 0 3px,
      transparent 3px 6px
    );
  }
  /* 英文模式：与桌面导航一致，像素字体 */
  :global(html[lang='en']) .mobile-link {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
  }
</style>

<script>
  // logo：单点回首页；280ms 内连点 3 次 → 进房间（彩蛋）
  // 去掉 BASE_URL 末尾的 / 再拼接，避免 dev 下变成协议相对的 //room / //
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  let logoClicks = 0;
  let logoTimer: number | undefined;
  document.getElementById('siteLogo')?.addEventListener('click', (e) => {
    e.preventDefault();
    logoClicks++;
    window.clearTimeout(logoTimer);
    if (logoClicks >= 3) {
      logoClicks = 0;
      window.location.href = base + '/room';
    } else {
      logoTimer = window.setTimeout(() => {
        window.location.href = base + '/';
        logoClicks = 0;
      }, 280);
    }
  });

  // 移动端汉堡菜单
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
        setOpen(false);
      }
    });
  }
</script>
