---
import { SITE, NAV_LINKS } from '../data/site';
import T from './T.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import GitHubIcon from './icons/GitHub.astro';
import BilibiliIcon from './icons/Bilibili.astro';

const path = Astro.url.pathname;
const _base = import.meta.env.BASE_URL.replace(/\/$/, ''); // dev: '' prod: '/Z-sBlog'
---

<header>
  <nav>
    <a href={`${_base}/`} class="logo" id="siteLogo">{SITE.name}</a>
    <div class="links">
      {
        NAV_LINKS.map((l) => (
          <a
            href={`${_base}${l.href}`}
            class:list={['nav-link', { active: path.startsWith(`${_base}${l.href}`) }]}
          >
            <T k={`nav.${l.href.slice(1)}`} />
          </a>
        ))
      }
    </div>
    <div class="social">
      <a href={SITE.social.github} target="_blank" rel="noopener" aria-label="GitHub">
        <GitHubIcon />
      </a>
      <a href={SITE.social.bilibili} target="_blank" rel="noopener" aria-label="Bilibili">
        <BilibiliIcon />
      </a>
      <LangToggle />
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  nav {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .logo {
    font-family: Georgia, "PingFang SC", serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .logo:hover {
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    flex: 1;
  }
  .nav-link {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
    text-decoration: none;
  }
  .social {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .social a {
    color: var(--color-text-muted);
    display: flex;
  }
  .social a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .links {
      display: none;
    }
  }
</style>

<script>
  // logo：单点回首页；280ms 内连点 3 次 → 进房间（彩蛋）
  // 去掉 BASE_URL 末尾的 / 再拼接，避免 dev 下变成协议相对的 //room / //
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  let logoClicks = 0;
  let logoTimer: number | undefined;
  document.getElementById('siteLogo')?.addEventListener('click', (e) => {
    e.preventDefault();
    logoClicks++;
    window.clearTimeout(logoTimer);
    if (logoClicks >= 3) {
      logoClicks = 0;
      window.location.href = base + '/room';
    } else {
      logoTimer = window.setTimeout(() => {
        window.location.href = base + '/';
        logoClicks = 0;
      }, 280);
    }
  });
</script>
