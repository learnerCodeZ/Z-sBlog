---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { execSync } from 'node:child_process';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = '一个在嵌入式与 AI 交叉点上折腾的人的博客' } =
  Astro.props;
const siteName = 'learnerCodeZ.';
const isRoom = Astro.url.pathname.replace(/\/$/, '').endsWith('room');
const _base = import.meta.env.BASE_URL.replace(/\/$/, ''); // dev: '' prod: '/Z-sBlog'
const homeHref = _base + '/';
const roomHref = _base + '/room';

// 最近更新 = git 最后提交日期（构建时注入，静态）
let lastUpdated = '';
try {
  lastUpdated = execSync('git log -1 --format=%cd --date=short')
    .toString()
    .trim();
} catch {
  lastUpdated = new Date().toISOString().slice(0, 10);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${_base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    <meta name="description" content={description} />
    <!-- 防止刷新时主题闪烁：在渲染前就应用已存的主题 -->
    <script is:inline>
      (function () {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.add('light');
        }
        if (localStorage.getItem('lang') === 'en') {
          document.documentElement.lang = 'en';
        }
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <span>© learnerCodeZ</span>
        <span class="footer-meta">Established late July 2026 · Last updated {lastUpdated}</span>
      </div>
    </footer>
    <a class="room-float" href={isRoom ? homeHref : roomHref} aria-label={isRoom ? '返回主页' : '房间'}>
      <svg width="24" height="28" viewBox="0 0 12 14" shape-rendering="crispEdges">
        <!-- 像素门框 -->
        <rect x="1" y="0" width="1" height="14" fill="currentColor"/>
        <rect x="9" y="0" width="1" height="14" fill="currentColor"/>
        <rect x="1" y="0" width="8" height="1" fill="currentColor"/>
        <!-- 像素门面 -->
        <rect x="2" y="1" width="6" height="13" fill="currentColor" opacity="0.15"/>
        <!-- 把手 -->
        <rect x="7" y="7" width="1" height="1" fill="currentColor"/>
      </svg>
      <span class="room-float-tip">
        {isRoom
          ? <><span data-zh>主页</span><span data-en>Home</span></>
          : <><span data-zh>房间</span><span data-en>Room</span></>
        }
      </span>
    </a>
  </body>
</html>
