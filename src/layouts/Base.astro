---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { execSync } from 'node:child_process';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = '一个在嵌入式与 AI 交叉点上折腾的人的博客' } =
  Astro.props;
const siteName = 'learnerCode.';
const isRoom = Astro.url.pathname.replace(/\/$/, '').endsWith('room');

// 最近更新 = git 最后提交日期（构建时注入，静态）
let lastUpdated = '';
try {
  lastUpdated = execSync('git log -1 --format=%cd --date=short')
    .toString()
    .trim();
} catch {
  lastUpdated = new Date().toISOString().slice(0, 10);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    <meta name="description" content={description} />
    <!-- 防止刷新时主题闪烁：在渲染前就应用已存的主题 -->
    <script is:inline>
      (function () {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.add('light');
        }
        if (localStorage.getItem('lang') === 'en') {
          document.documentElement.lang = 'en';
        }
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <span>© learnerCodeZ</span>
        <span class="footer-meta">Established late July 2026 · Last updated {lastUpdated}</span>
      </div>
    </footer>
    <a class="room-float" href={isRoom ? import.meta.env.BASE_URL + '/' : import.meta.env.BASE_URL + '/room'} aria-label={isRoom ? '返回主页' : '房间'}>
      <svg width="26" height="32" viewBox="0 0 26 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="2" width="18" height="28" rx="2"></rect>
        <line x1="4" y1="2" x2="4" y2="30"></line>
        <circle cx="18" cy="16" r="1.4" fill="currentColor" stroke="none"></circle>
      </svg>
      <span class="room-float-tip">
        {isRoom
          ? <><span data-zh>主页</span><span data-en>Home</span></>
          : <><span data-zh>房间</span><span data-en>Room</span></>
        }
      </span>
    </a>
  </body>
</html>
